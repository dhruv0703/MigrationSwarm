  "package_root": "com.example.commerce",
  "ignored_package_segments": ["shared", "config"],
  "shared_components": ["AuditStamp", "DomainEvent", "Money", "SharedEventPublisher"],
  "notes": [
    "Orders depend on Inventory through InventoryGateway.",
    "Shared event and value-object classes are intentionally not assigned to one service.",
